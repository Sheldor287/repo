<bodyCondition xmi:id="Mappings-Helper-getScalarValueType_DataType-bodyCondition" xmi:type="uml:Constraint" name="bodyCondition">
<specification xmi:id="Mappings-Helper-getScalarValueType_DataType-bodyCondition-specification0" xmi:type="uml:OpaqueExpression" body="result = if t.oclIsUndefined() or t.name = '' or t.name.oclIsUndefined() or t.qualifiedName.oclIsUndefined() then OclUndefined else if (t.qualifiedName = 'SysML::Libraries::PrimitiveValueTypes::UnlimitedNatural') or t.qualifiedName.indexOf('PrimitiveTypes::UnlimitedNatural') &gt; 0 then SYSML2::DataType.allInstances() -&gt;any(e | e.qualifiedName = 'ScalarValues::Natural') else SYSML2::DataType.allInstances() -&gt;any(e | e.qualifiedName = 'ScalarValues::' + t.name) endif endif" language="OCL2.0" name=""> </specification>
</bodyCondition>

