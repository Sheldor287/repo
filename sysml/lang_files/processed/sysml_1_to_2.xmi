<upperValue xmi:id="Mappings-UML4SysML-StructuredClassifiers-OwnedEnd_Mapping-filter_Element-src-upperValue" xmi:type="uml:LiteralUnlimitedNatural" name="" value="1"/>
</ownedParameter>
