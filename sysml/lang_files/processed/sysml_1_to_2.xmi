<specification xmi:id="Mappings-UML4SysML-Activities-ControlNodeObjectFlowReferenceUsage_Mapping-declaredName_-bodyCondition-specification0" xmi:type="uml:OpaqueExpression" body="result = if from.target.oclIsTypeOf(UML::ForkNode) or from.target.oclIsTypeOf(UML::JoinNode) or from.target.oclIsTypeOf(UML::MergeNode) then 'inputObject' + from.target.incoming-&gt;indexOf(from).toString() else if from.source.oclIsTypeOf(UML::ForkNode) or from.source.oclIsTypeOf(UML::JoinNode) or from.target.oclIsTypeOf(UML::MergeNode) then 'outputObject' + from.source.outgoing-&gt;indexOf(from).toString() else OclUndefined endif endif" language="OCL2.0" name=""> </specification>
