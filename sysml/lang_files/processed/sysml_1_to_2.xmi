<specification xmi:id="Mappings-UML4SysML-InformationFlows-InformationFlow_Mapping-filter_Element-bodyCondition-specification0" xmi:type="uml:OpaqueExpression" body="result = src.oclIsKindOf(UML::InformationFlow) and (src.oclAsType(UML::InformationFlow).realizingConnector-&gt;notEmpty() or src.oclAsType(UML::InformationFlow).realization-&gt;notEmpty())" language="OCL2.0" name=""> </specification>
