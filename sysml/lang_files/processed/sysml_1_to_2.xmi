<specification xmi:id="Mappings-UML4SysML-StateMachines-Region_Mapping-ownedRelationship_-bodyCondition-specification0" xmi:type="uml:OpaqueExpression" body="result = let initialState : Set(UML::Pseudostate) = from.ownedElement-&gt;select(e | e.oclIsKindOf(UML::Pseudostate) and e.oclAsType(UML::Pseudostate).kind = PseudostateKind::initial)-&gt;asSet() in let toFeatureMS : Set(UML::Element) = from.ownedElement-&gt;select(e | e.oclIsKindOf(UML::Region))-&gt;asSet() in let toElementOMS : Set(UML::Element) = ((from.ownedElement - initialState) - toFeatureMS) - from.ownedComment in toElementOMS-&gt;collect(e | ElementOwningMembership_Mapping.getMapped(e))-&gt;asSet() -&gt;union(toFeatureMS-&gt;collect(e | ElementFeatureMembership_Mapping.getMapped(e))-&gt;asSet()) -&gt;union(initialState-&gt;collect(e | InitialStateMembership_Mapping.getMapped(e))-&gt;asSet()) -&gt;union(self.oclAsType(ElementMain_Mapping).ownedRelationship()) " language="OCL2.0" name=""> </specification>
