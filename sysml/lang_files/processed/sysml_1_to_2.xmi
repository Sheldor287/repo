<specification xmi:id="Mappings-SysMLv1-ModelElements-Concern_Mapping-ownedRelationship_-bodyCondition-specification0" xmi:type="uml:OpaqueExpression" body="result = let toStakeholderMS : Set(UML::Classifier) = UML::Classifier.allInstances() -&gt;select(s | Helper.hasStereotypeApplied(s, 'SysML::ModelElements::Stakeholder')) -&gt;select(s | Helper.getTagValue(s, 'SysML::ModelElements::Stakeholder', 'concernList') -&gt;flatten()-&gt;includes(from))-&gt;asSet() in toStakeholderMS -&gt;including( CommonReturnParameterReferenceUsageMembership_Mapping.getMapped(from)) -&gt;including(EmptySubjectMembership_Factory.create()) -&gt;union(self.oclAsType(Comment_Mapping).ownedRelationship())" language="OCL2.0" name=""> </specification>
</bodyCondition>
