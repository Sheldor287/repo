<specification xmi:id="Mappings-UML4SysML-Activities-JoinNode_Mapping-ownedRelationship_-bodyCondition-specification0" xmi:type="uml:OpaqueExpression" body="result = if not (src.incoming-&gt;forAll(e | e.oclIsTypeOf(UML::ControlFlow)) and src.outgoing-&gt;forAll(e | e.oclIsTypeOf(UML::ControlFlow))) then from.ownedElement-&gt;collect(e | ElementOwningMembership_Mapping.getMapped(e))-&gt;asSet() -&gt;union(from.incoming-&gt;collect(i | ControlNodeObjectFlowFeatureMembership_Mapping.getMapped(i))-&gt;asSet()) -&gt;union(from.outgoing-&gt;collect(i | ControlNodeObjectFlowFeatureMembership_Mapping.getMapped(i))-&gt;asSet()) else Set{} endif" language="OCL2.0" name=""> </specification>
</bodyCondition>
