<specification xmi:id="Mappings-Helper-isRequirement_Element-bodyCondition-specification0" xmi:type="uml:OpaqueExpression" body="result = let stereotypes: Set(UML::Stereotype) = Helper.getAppliedStereotypes(element) in stereotypes-&gt;exists(s | s.general-&gt;collect(g | g.qualifiedName) -&gt;includes('SysML::Requirements::AbstractRequirement'))" language="OCL2.0" name=""> </specification>
