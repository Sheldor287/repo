<upperValue xmi:id="Mappings-UML4SysML-Activities-ObjectFlowItemFlowEndReferenceUsage_Mapping-ownedRelationship_-result-upperValue" xmi:type="uml:LiteralUnlimitedNatural" name="" value="-1"/>
