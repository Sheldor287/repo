<specification xmi:id="Mappings-Factories-MultiplicityMembership_Factory-ownedMemberFeature_-bodyCondition-specification0" xmi:type="uml:OpaqueExpression" body="result = if upperValue = 1 then if lowerValue = 0 then Helper.getMultiplicityRangeByName('zeroOrOne') else if lowerValue = 1 then Helper.getMultiplicityRangeByName('exactlyOne') else MultiplicityElement_Factory.create(lowerValue, upperValue) endif endif else if upperValue = -1 then if lowerValue = 0 then Helper.getMultiplicityRangeByName('zeroToMany') else if lowerValue = 1 then Helper.getMultiplicityRangeByName('oneToMany') else MultiplicityElement_Factory.create(lowerValue, upperValue) endif endif else MultiplicityElement_Factory.create(lowerValue, upperValue) endif endif" language="OCL2.0" name=""> </specification>
</bodyCondition>
