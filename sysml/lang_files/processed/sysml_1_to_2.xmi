<upperValue xmi:id="Mappings-UML4SysML-StructuredClassifiers-OwnedEnd_Mapping-ownedRelationship_-result-upperValue" xmi:type="uml:LiteralUnlimitedNatural" name="" value="-1"/>
</ownedParameter>
