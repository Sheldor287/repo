<ownedOperation xmi:id="Mappings-UML4SysML-StructuredClassifiers-OwnedEnd_Mapping-filter_Element" xmi:type="uml:Operation" isQuery="true" isStatic="true" name="filter">
<bodyCondition xmi:id="Mappings-UML4SysML-StructuredClassifiers-OwnedEnd_Mapping-filter_Element-bodyCondition" xmi:type="uml:Constraint" name="bodyCondition">
<specification xmi:id="Mappings-UML4SysML-StructuredClassifiers-OwnedEnd_Mapping-filter_Element-bodyCondition-specification0" xmi:type="uml:OpaqueExpression" body="result = let p: UML::Property = src.oclAsType(UML::Property) in not p.oclIsUndefined() and (not p.association.oclIsUndefined() and p.association.ownedEnd-&gt;includes(p)) and (not p.association.memberEnd -&gt;select( m | (not m.type.oclIsUndefined()) and m.type.oclIsTypeOf(UML::UseCase))-&gt;notEmpty())" language="OCL2.0" name=""> </specification>
</bodyCondition>

<ownedParameter xmi:id="Mappings-UML4SysML-StructuredClassifiers-OwnedEnd_Mapping-filter_Element-result" xmi:type="uml:Parameter" name="result">
