<bodyCondition xmi:id="Mappings-Helper-getKerMLFeatureDirectionKind_EnumerationLiteral-bodyCondition" xmi:type="uml:Constraint" name="bodyCondition">
<specification xmi:id="Mappings-Helper-getKerMLFeatureDirectionKind_EnumerationLiteral-bodyCondition-specification0" xmi:type="uml:OpaqueExpression" body="result = if v.enumeration.qualifiedName = 'SysML::Ports&amp;Flows::FeatureDirectionKind' or v.enumeration.qualifiedName = 'SysML::Ports&amp;Flows::FeatureDirection' then if v = SysML::FeatureDirectionKind::provided then KerML::FeatureDirectionKind::_'out' else if (v = SysML::FeatureDirectionKind::required) then KerML::FeatureDirectionKind::_'in' else if (v = SysML::FeatureDirectionKind::providedRequired) then KerML::FeatureDirectionKind::inout else invalid endif endif endif else invalid endif " language="OCL2.0" name=""> </specification>
</bodyCondition>

