<type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Boolean"/>

</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="State-isOrthogonal" name="isOrthogonal" isReadOnly="true" isDerived="true">
<type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Boolean"/>

</ownedAttribute>
