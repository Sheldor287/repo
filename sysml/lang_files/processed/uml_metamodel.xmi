<packagedElement xmi:type="uml:Class" xmi:id="ReadLinkAction" name="ReadLinkAction">

<ownedRule xmi:type="uml:Constraint" xmi:id="ReadLinkAction-type_and_ordering" name="type_and_ordering">
<constrainedElement xmi:idref="ReadLinkAction"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="ReadLinkAction-type_and_ordering-_specification">
<body>self.openEnd()->forAll(type=result.type and isOrdered=result.isOrdered) </body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="ReadLinkAction-compatible_multiplicity" name="compatible_multiplicity">
<constrainedElement xmi:idref="ReadLinkAction"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="ReadLinkAction-compatible_multiplicity-_specification">
<body>self.openEnd()->first().compatibleWith(result) </body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="ReadLinkAction-visibility" name="visibility">
<constrainedElement xmi:idref="ReadLinkAction"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="ReadLinkAction-visibility-_specification">
<body>let openEnd : Property = self.openEnd()->first() in openEnd.visibility = VisibilityKind::public or endData->exists(oed | oed.end&lt;&gt;openEnd and (_'context' = oed.end.type or (openEnd.visibility = VisibilityKind::protected and _'context'.conformsTo(oed.end.type.oclAsType(Classifier))))) </body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="ReadLinkAction-one_open_end" name="one_open_end">
<constrainedElement xmi:idref="ReadLinkAction"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="ReadLinkAction-one_open_end-_specification">
<body>self.openEnd()->size() = 1</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="ReadLinkAction-navigable_open_end" name="navigable_open_end">
<constrainedElement xmi:idref="ReadLinkAction"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="ReadLinkAction-navigable_open_end-_specification">
<body>self.openEnd()->first().isNavigable() </body>
<language>OCL</language>
</specification>
</ownedRule>
<generalization xmi:type="uml:Generalization" xmi:id="ReadLinkAction-_generalization.0" general="LinkAction"/>
<ownedAttribute xmi:type="uml:Property" xmi:id="ReadLinkAction-result" name="result" aggregation="composite" type="OutputPin" association="A_result_readLinkAction">
<subsettedProperty xmi:idref="Action-output"/>

</ownedAttribute>
<ownedOperation xmi:type="uml:Operation" xmi:id="ReadLinkAction-openEnd" name="openEnd" isQuery="true" bodyCondition="ReadLinkAction-openEnd-spec">

