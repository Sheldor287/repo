<upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="TemplateSignature-parameter-_upperValue" value="*"/>
</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="TemplateSignature-template" name="template" type="TemplateableElement" association="A_ownedTemplateSignature_template">
<subsettedProperty xmi:idref="Element-owner"/>

