</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="ReduceAction-reducer" name="reducer" type="Behavior" association="A_reducer_reduceAction">

</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="ReduceAction-result" name="result" aggregation="composite" type="OutputPin" association="A_result_reduceAction">
<subsettedProperty xmi:idref="Action-output"/>

</ownedAttribute>
</packagedElement>
<packagedElement xmi:type="uml:Class" xmi:id="RemoveStructuralFeatureValueAction" name="RemoveStructuralFeatureValueAction">

<ownedRule xmi:type="uml:Constraint" xmi:id="RemoveStructuralFeatureValueAction-removeAt_and_value" name="removeAt_and_value">
<constrainedElement xmi:idref="RemoveStructuralFeatureValueAction"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="RemoveStructuralFeatureValueAction-removeAt_and_value-_specification">
<body>if structuralFeature.isOrdered and not structuralFeature.isUnique and not isRemoveDuplicates then value = null and removeAt &lt;&gt; null and removeAt.type = UnlimitedNatural and removeAt.is(1,1) else removeAt = null and value &lt;&gt; null endif</body>
<language>OCL</language>
</specification>
</ownedRule>
<generalization xmi:type="uml:Generalization" xmi:id="RemoveStructuralFeatureValueAction-_generalization.0" general="WriteStructuralFeatureAction"/>
<ownedAttribute xmi:type="uml:Property" xmi:id="RemoveStructuralFeatureValueAction-isRemoveDuplicates" name="isRemoveDuplicates">
<type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Boolean"/>

<defaultValue xmi:type="uml:LiteralBoolean" xmi:id="RemoveStructuralFeatureValueAction-isRemoveDuplicates-_defaultValue"/>
</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="RemoveStructuralFeatureValueAction-removeAt" name="removeAt" aggregation="composite" type="InputPin" association="A_removeAt_removeStructuralFeatureValueAction">
<subsettedProperty xmi:idref="Action-input"/>

<lowerValue xmi:type="uml:LiteralInteger" xmi:id="RemoveStructuralFeatureValueAction-removeAt-_lowerValue"/>
</ownedAttribute>
</packagedElement>
