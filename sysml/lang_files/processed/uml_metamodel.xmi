<constrainedElement xmi:idref="TemplateParameter"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="TemplateParameter-must_be_compatible-_specification">
<body>default &lt;&gt; null implies default.isCompatibleWith(parameteredElement)</body>
<language>OCL</language>
</specification>
</ownedRule>
<generalization xmi:type="uml:Generalization" xmi:id="TemplateParameter-_generalization.0" general="Element"/>
<ownedAttribute xmi:type="uml:Property" xmi:id="TemplateParameter-default" name="default" type="ParameterableElement" association="A_default_templateParameter">

<lowerValue xmi:type="uml:LiteralInteger" xmi:id="TemplateParameter-default-_lowerValue"/>
</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="TemplateParameter-ownedDefault" name="ownedDefault" aggregation="composite" type="ParameterableElement" association="A_ownedDefault_templateParameter">
<subsettedProperty xmi:idref="Element-ownedElement"/>
<subsettedProperty xmi:idref="TemplateParameter-default"/>

<lowerValue xmi:type="uml:LiteralInteger" xmi:id="TemplateParameter-ownedDefault-_lowerValue"/>
</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="TemplateParameter-ownedParameteredElement" name="ownedParameteredElement" aggregation="composite" type="ParameterableElement" association="A_ownedParameteredElement_owningTemplateParameter">
<subsettedProperty xmi:idref="Element-ownedElement"/>
<subsettedProperty xmi:idref="TemplateParameter-parameteredElement"/>

<lowerValue xmi:type="uml:LiteralInteger" xmi:id="TemplateParameter-ownedParameteredElement-_lowerValue"/>
</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="TemplateParameter-parameteredElement" name="parameteredElement" type="ParameterableElement" association="A_parameteredElement_templateParameter">

</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="TemplateParameter-signature" name="signature" type="TemplateSignature" association="A_ownedParameter_signature">
<subsettedProperty xmi:idref="A_parameter_templateSignature-templateSignature"/>
<subsettedProperty xmi:idref="Element-owner"/>

</ownedAttribute>
</packagedElement>
<packagedElement xmi:type="uml:Class" xmi:id="TemplateParameterSubstitution" name="TemplateParameterSubstitution">

<ownedRule xmi:type="uml:Constraint" xmi:id="TemplateParameterSubstitution-must_be_compatible" name="must_be_compatible">
<constrainedElement xmi:idref="TemplateParameterSubstitution"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="TemplateParameterSubstitution-must_be_compatible-_specification">
<body>actual->forAll(a | a.isCompatibleWith(formal.parameteredElement))</body>
<language>OCL</language>
</specification>
</ownedRule>
<generalization xmi:type="uml:Generalization" xmi:id="TemplateParameterSubstitution-_generalization.0" general="Element"/>
<ownedAttribute xmi:type="uml:Property" xmi:id="TemplateParameterSubstitution-actual" name="actual" type="ParameterableElement" association="A_actual_templateParameterSubstitution">

