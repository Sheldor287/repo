<constrainedElement xmi:idref="Action-containingBehavior"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="Action-containingBehavior-spec-_specification">
<body>result = (if inStructuredNode&lt;&gt;null then inStructuredNode.containingBehavior() else if activity&lt;&gt;null then activity else interaction endif endif )</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedParameter xmi:type="uml:Parameter" xmi:id="Action-containingBehavior-result" name="result" direction="return" type="Behavior">
