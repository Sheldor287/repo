<packagedElement xmi:type="uml:Class" xmi:id="ObjectNode" name="ObjectNode" isAbstract="true">

<ownedRule xmi:type="uml:Constraint" xmi:id="ObjectNode-input_output_parameter" name="input_output_parameter">
<constrainedElement xmi:idref="ObjectNode"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="ObjectNode-input_output_parameter-_specification">
<body>selection&lt;&gt;null implies selection.inputParameters()->size()=1 and selection.inputParameters()->forAll(p | not p.isUnique and p.is(0,*) and self.type.conformsTo(p.type)) and selection.outputParameters()->size()=1 and selection.inputParameters()->forAll(p | self.type.conformsTo(p.type)) </body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="ObjectNode-selection_behavior" name="selection_behavior">
<constrainedElement xmi:idref="ObjectNode"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="ObjectNode-selection_behavior-_specification">
<body>(selection&lt;&gt;null) = (ordering=ObjectNodeOrderingKind::ordered)</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="ObjectNode-object_flow_edges" name="object_flow_edges">
<constrainedElement xmi:idref="ObjectNode"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="ObjectNode-object_flow_edges-_specification">
<body>(not isControlType) implies incoming->union(outgoing)->forAll(oclIsKindOf(ObjectFlow))</body>
<language>OCL</language>
</specification>
</ownedRule>
