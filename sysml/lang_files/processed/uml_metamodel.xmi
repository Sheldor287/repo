<lowerValue xmi:type="uml:LiteralInteger" xmi:id="ParameterableElement-templateParameter-_lowerValue"/>
</ownedAttribute>
<ownedOperation xmi:type="uml:Operation" xmi:id="ParameterableElement-isCompatibleWith" name="isCompatibleWith" isQuery="true" bodyCondition="ParameterableElement-isCompatibleWith-spec">

<ownedRule xmi:type="uml:Constraint" xmi:id="ParameterableElement-isCompatibleWith-spec" name="spec">
<constrainedElement xmi:idref="ParameterableElement-isCompatibleWith"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="ParameterableElement-isCompatibleWith-spec-_specification">
<body>result = (self.oclIsKindOf(p.oclType()))</body>
<language>OCL</language>
</specification>
</ownedRule>
