<subsettedProperty xmi:idref="Feature-featuringClassifier"/>
<subsettedProperty xmi:idref="NamedElement-namespace"/>
<subsettedProperty xmi:idref="RedefinableElement-redefinitionContext"/>

<lowerValue xmi:type="uml:LiteralInteger" xmi:id="Operation-datatype-_lowerValue"/>
</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="Operation-interface" name="interface" type="Interface" association="A_ownedOperation_interface">
<subsettedProperty xmi:idref="Feature-featuringClassifier"/>
<subsettedProperty xmi:idref="NamedElement-namespace"/>
<subsettedProperty xmi:idref="RedefinableElement-redefinitionContext"/>

<lowerValue xmi:type="uml:LiteralInteger" xmi:id="Operation-interface-_lowerValue"/>
</ownedAttribute>
