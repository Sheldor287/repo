<subsettedProperty xmi:idref="DirectedRelationship-target"/>

</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="Include-includingCase" name="includingCase" type="UseCase" association="A_include_includingCase">
<subsettedProperty xmi:idref="DirectedRelationship-source"/>
<subsettedProperty xmi:idref="NamedElement-namespace"/>

</ownedAttribute>
</packagedElement>
<packagedElement xmi:type="uml:Class" xmi:id="UseCase" name="UseCase">

<ownedRule xmi:type="uml:Constraint" xmi:id="UseCase-binary_associations" name="binary_associations">
<constrainedElement xmi:idref="UseCase"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="UseCase-binary_associations-_specification">
<body>Association.allInstances()->forAll(a | a.memberEnd.type->includes(self) implies a.memberEnd->size() = 2)</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="UseCase-no_association_to_use_case" name="no_association_to_use_case">
<constrainedElement xmi:idref="UseCase"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="UseCase-no_association_to_use_case-_specification">
<body>Association.allInstances()->forAll(a | a.memberEnd.type->includes(self) implies ( let usecases: Set(UseCase) = a.memberEnd.type->select(oclIsKindOf(UseCase))->collect(oclAsType(UseCase))->asSet() in usecases->size() > 1 implies usecases->collect(subject)->size() > 1 ) )</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="UseCase-cannot_include_self" name="cannot_include_self">
<constrainedElement xmi:idref="UseCase"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="UseCase-cannot_include_self-_specification">
<body>not allIncludedUseCases()->includes(self)</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="UseCase-must_have_name" name="must_have_name">
<constrainedElement xmi:idref="UseCase"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="UseCase-must_have_name-_specification">
<body>name -> notEmpty ()</body>
<language>OCL</language>
</specification>
</ownedRule>
<generalization xmi:type="uml:Generalization" xmi:id="UseCase-_generalization.0" general="BehavioredClassifier"/>
<ownedAttribute xmi:type="uml:Property" xmi:id="UseCase-extend" name="extend" aggregation="composite" type="Extend" association="A_extend_extension">
<subsettedProperty xmi:idref="A_source_directedRelationship-directedRelationship"/>
<subsettedProperty xmi:idref="Namespace-ownedMember"/>

<lowerValue xmi:type="uml:LiteralInteger" xmi:id="UseCase-extend-_lowerValue"/>
<upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UseCase-extend-_upperValue" value="*"/>
</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="UseCase-extensionPoint" name="extensionPoint" aggregation="composite" type="ExtensionPoint" association="A_extensionPoint_useCase">
<subsettedProperty xmi:idref="Namespace-ownedMember"/>

<lowerValue xmi:type="uml:LiteralInteger" xmi:id="UseCase-extensionPoint-_lowerValue"/>
<upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UseCase-extensionPoint-_upperValue" value="*"/>
</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="UseCase-include" name="include" aggregation="composite" type="Include" association="A_include_includingCase">
<subsettedProperty xmi:idref="A_source_directedRelationship-directedRelationship"/>
<subsettedProperty xmi:idref="Namespace-ownedMember"/>

<lowerValue xmi:type="uml:LiteralInteger" xmi:id="UseCase-include-_lowerValue"/>
<upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UseCase-include-_upperValue" value="*"/>
</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="UseCase-subject" name="subject" type="Classifier" association="A_subject_useCase">

<lowerValue xmi:type="uml:LiteralInteger" xmi:id="UseCase-subject-_lowerValue"/>
<upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UseCase-subject-_upperValue" value="*"/>
</ownedAttribute>
<ownedOperation xmi:type="uml:Operation" xmi:id="UseCase-allIncludedUseCases" name="allIncludedUseCases" isQuery="true" bodyCondition="UseCase-allIncludedUseCases-spec">

<ownedRule xmi:type="uml:Constraint" xmi:id="UseCase-allIncludedUseCases-spec" name="spec">
<constrainedElement xmi:idref="UseCase-allIncludedUseCases"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="UseCase-allIncludedUseCases-spec-_specification">
<body>result = (self.include.addition->union(self.include.addition->collect(uc | uc.allIncludedUseCases()))->asSet())</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedParameter xmi:type="uml:Parameter" xmi:id="UseCase-allIncludedUseCases-result" name="result" direction="return" type="UseCase">
<lowerValue xmi:type="uml:LiteralInteger" xmi:id="UseCase-allIncludedUseCases-result-_lowerValue"/>
<upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UseCase-allIncludedUseCases-result-_upperValue" value="*"/>
</ownedParameter>
</ownedOperation>
</packagedElement>
