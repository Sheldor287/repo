<ownedRule xmi:type="uml:Constraint" xmi:id="Class-extension.1-spec" name="spec">
<constrainedElement xmi:idref="Class-extension.1"/>
<constrainedElement xmi:idref="Class-extension"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="Class-extension.1-spec-_specification">
<body>result = (Extension.allInstances()->select(ext | let endTypes : Sequence(Classifier) = ext.memberEnd->collect(type.oclAsType(Classifier)) in endTypes->includes(self) or endTypes.allParents()->includes(self) ))</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedParameter xmi:type="uml:Parameter" xmi:id="Class-extension.1-result" name="result" direction="return" type="Extension">
<lowerValue xmi:type="uml:LiteralInteger" xmi:id="Class-extension.1-result-_lowerValue"/>
<upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Class-extension.1-result-_upperValue" value="*"/>
</ownedParameter>
