<ownedRule xmi:type="uml:Constraint" xmi:id="LinkEndData-allPins-spec" name="spec">
<constrainedElement xmi:idref="LinkEndData-allPins"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="LinkEndData-allPins-spec-_specification">
