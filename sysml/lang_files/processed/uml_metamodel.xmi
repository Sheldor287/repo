<constrainedElement xmi:idref="BroadcastSignalAction"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="BroadcastSignalAction-number_of_arguments-_specification">
<body>argument->size() = signal.allAttributes()->size()</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="BroadcastSignalAction-type_ordering_multiplicity" name="type_ordering_multiplicity">
<constrainedElement xmi:idref="BroadcastSignalAction"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="BroadcastSignalAction-type_ordering_multiplicity-_specification">
<body>let attribute: OrderedSet(Property) = signal.allAttributes() in Sequence{1..argument->size()}->forAll(i | argument->at(i).type.conformsTo(attribute->at(i).type) and argument->at(i).isOrdered = attribute->at(i).isOrdered and argument->at(i).compatibleWith(attribute->at(i)))</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="BroadcastSignalAction-no_onport" name="no_onport">
