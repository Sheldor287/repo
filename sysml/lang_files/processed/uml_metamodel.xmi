<ownedAttribute xmi:type="uml:Property" xmi:id="CreateLinkObjectAction-result" name="result" aggregation="composite" type="OutputPin" association="A_result_createLinkObjectAction">
<subsettedProperty xmi:idref="Action-output"/>

