<packagedElement xmi:type="uml:Class" xmi:id="SendObjectAction" name="SendObjectAction">

<ownedRule xmi:type="uml:Constraint" xmi:id="SendObjectAction-type_target_pin" name="type_target_pin">
<constrainedElement xmi:idref="SendObjectAction"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="SendObjectAction-type_target_pin-_specification">
<body>onPort&lt;&gt;null implies target.type.oclAsType(Classifier).allFeatures()->includes(onPort)</body>
<language>OCL</language>
</specification>
</ownedRule>
<generalization xmi:type="uml:Generalization" xmi:id="SendObjectAction-_generalization.0" general="InvocationAction"/>
