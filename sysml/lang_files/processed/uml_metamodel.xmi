<packagedElement xmi:type="uml:Class" xmi:id="Behavior" name="Behavior" isAbstract="true">

<ownedRule xmi:type="uml:Constraint" xmi:id="Behavior-most_one_behavior" name="most_one_behavior">
<constrainedElement xmi:idref="Behavior"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="Behavior-most_one_behavior-_specification">
<body>specification &lt;&gt; null implies _'context'.ownedBehavior->select(specification=self.specification)->size() = 1</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="Behavior-parameters_match" name="parameters_match">
<constrainedElement xmi:idref="Behavior"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="Behavior-parameters_match-_specification">
<body>specification &lt;&gt; null implies ownedParameter->size() = specification.ownedParameter->size()</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="Behavior-feature_of_context_classifier" name="feature_of_context_classifier">
<constrainedElement xmi:idref="Behavior"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="Behavior-feature_of_context_classifier-_specification">
<body>_'context'.feature->includes(specification)</body>
<language>OCL</language>
</specification>
</ownedRule>
<generalization xmi:type="uml:Generalization" xmi:id="Behavior-_generalization.0" general="Class"/>
<ownedAttribute xmi:type="uml:Property" xmi:id="Behavior-context" name="context" isReadOnly="true" isDerived="true" type="BehavioredClassifier" association="A_context_behavior">
