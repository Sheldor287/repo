<precondition xmi:idref="ConnectionPointReference-isConsistentWith-pre"/>
<redefinedOperation xmi:idref="RedefinableElement-isConsistentWith"/>

<ownedRule xmi:type="uml:Constraint" xmi:id="ConnectionPointReference-isConsistentWith-pre" name="pre">
<constrainedElement xmi:idref="ConnectionPointReference-isConsistentWith"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="ConnectionPointReference-isConsistentWith-pre-_specification">
<body>redefiningElement.isRedefinitionContextValid(self)</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="ConnectionPointReference-isConsistentWith-spec" name="spec">
<constrainedElement xmi:idref="ConnectionPointReference-isConsistentWith"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="ConnectionPointReference-isConsistentWith-spec-_specification">
<body>result = redefiningElement.oclIsKindOf(ConnectionPointReference)</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedParameter xmi:type="uml:Parameter" xmi:id="ConnectionPointReference-isConsistentWith-redefiningElement" name="redefiningElement" visibility="public" type="RedefinableElement"/>
