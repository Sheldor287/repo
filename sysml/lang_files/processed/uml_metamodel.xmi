<ownedRule xmi:type="uml:Constraint" xmi:id="Classifier-hasVisibilityOf-pre" name="pre">
<constrainedElement xmi:idref="Classifier-hasVisibilityOf"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="Classifier-hasVisibilityOf-pre-_specification">
<body>allParents()->including(self)->collect(member)->includes(n)</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="Classifier-hasVisibilityOf-spec" name="spec">
<constrainedElement xmi:idref="Classifier-hasVisibilityOf"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="Classifier-hasVisibilityOf-spec-_specification">
<body>result = (n.visibility &lt;&gt; VisibilityKind::private)</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedParameter xmi:type="uml:Parameter" xmi:id="Classifier-hasVisibilityOf-result" name="result" direction="return">
