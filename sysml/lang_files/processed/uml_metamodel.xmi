<specification xmi:type="uml:OpaqueExpression" xmi:id="RemoveVariableValueAction-removeAt_and_value-_specification">
<body>if variable.isOrdered and not variable.isUnique and not isRemoveDuplicates then value = null and removeAt &lt;&gt; null and removeAt.type = UnlimitedNatural and removeAt.is(1,1) else removeAt = null and value &lt;&gt; null endif</body>
<language>OCL</language>
</specification>
</ownedRule>
