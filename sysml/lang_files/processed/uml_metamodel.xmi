<specification xmi:type="uml:OpaqueExpression" xmi:id="OpaqueExpression-only_in_or_return_parameters-_specification">
<body>behavior &lt;&gt; null implies behavior.ownedParameter->forAll(not isStream and (direction=ParameterDirectionKind::in or direction=ParameterDirectionKind::return))</body>
<language>OCL</language>
</specification>
</ownedRule>
