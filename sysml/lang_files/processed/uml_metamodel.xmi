<subsettedProperty xmi:idref="Feature-featuringClassifier"/>
<subsettedProperty xmi:idref="NamedElement-namespace"/>
<subsettedProperty xmi:idref="RedefinableElement-redefinitionContext"/>

<lowerValue xmi:type="uml:LiteralInteger" xmi:id="Operation-class-_lowerValue"/>
</ownedAttribute>
