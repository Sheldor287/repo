<upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="TemplateableElement-templateBinding-_upperValue" value="*"/>
</ownedAttribute>
<ownedOperation xmi:type="uml:Operation" xmi:id="TemplateableElement-isTemplate" name="isTemplate" isQuery="true" bodyCondition="TemplateableElement-isTemplate-spec">

<ownedRule xmi:type="uml:Constraint" xmi:id="TemplateableElement-isTemplate-spec" name="spec">
<constrainedElement xmi:idref="TemplateableElement-isTemplate"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="TemplateableElement-isTemplate-spec-_specification">
<body>result = (ownedTemplateSignature &lt;&gt; null)</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedParameter xmi:type="uml:Parameter" xmi:id="TemplateableElement-isTemplate-result" name="result" direction="return">
<type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Boolean"/>
</ownedParameter>
</ownedOperation>
<ownedOperation xmi:type="uml:Operation" xmi:id="TemplateableElement-parameterableElements" name="parameterableElements" isQuery="true" bodyCondition="TemplateableElement-parameterableElements-spec">

<ownedRule xmi:type="uml:Constraint" xmi:id="TemplateableElement-parameterableElements-spec" name="spec">
<constrainedElement xmi:idref="TemplateableElement-parameterableElements"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="TemplateableElement-parameterableElements-spec-_specification">
<body>result = (self.allOwnedElements()->select(oclIsKindOf(ParameterableElement)).oclAsType(ParameterableElement)->asSet())</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedParameter xmi:type="uml:Parameter" xmi:id="TemplateableElement-parameterableElements-result" name="result" direction="return" type="ParameterableElement">
<lowerValue xmi:type="uml:LiteralInteger" xmi:id="TemplateableElement-parameterableElements-result-_lowerValue"/>
<upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="TemplateableElement-parameterableElements-result-_upperValue" value="*"/>
</ownedParameter>
</ownedOperation>
</packagedElement>
