<ownedRule xmi:type="uml:Constraint" xmi:id="Namespace-cannot_import_self" name="cannot_import_self">
<constrainedElement xmi:idref="Namespace"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="Namespace-cannot_import_self-_specification">
<body>packageImport.importedPackage.oclAsType(Namespace)->excludes(self)</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="Namespace-cannot_import_ownedMembers" name="cannot_import_ownedMembers">
