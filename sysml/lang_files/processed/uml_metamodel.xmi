<ownedRule xmi:type="uml:Constraint" xmi:id="ValueSpecificationAction-multiplicity" name="multiplicity">
<constrainedElement xmi:idref="ValueSpecificationAction"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="ValueSpecificationAction-multiplicity-_specification">
<body>result.is(1,1)</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="ValueSpecificationAction-compatible_type" name="compatible_type">
<constrainedElement xmi:idref="ValueSpecificationAction"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="ValueSpecificationAction-compatible_type-_specification">
<body>value.type.conformsTo(result.type)</body>
<language>OCL</language>
</specification>
</ownedRule>
<generalization xmi:type="uml:Generalization" xmi:id="ValueSpecificationAction-_generalization.0" general="Action"/>
