<packagedElement xmi:type="uml:Class" xmi:id="FinalState" name="FinalState">

<ownedRule xmi:type="uml:Constraint" xmi:id="FinalState-no_exit_behavior" name="no_exit_behavior">
<constrainedElement xmi:idref="FinalState"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="FinalState-no_exit_behavior-_specification">
<body>exit->isEmpty()</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="FinalState-no_outgoing_transitions" name="no_outgoing_transitions">
<constrainedElement xmi:idref="FinalState"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="FinalState-no_outgoing_transitions-_specification">
<body>outgoing->size() = 0</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="FinalState-no_regions" name="no_regions">
<constrainedElement xmi:idref="FinalState"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="FinalState-no_regions-_specification">
<body>region->size() = 0</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="FinalState-cannot_reference_submachine" name="cannot_reference_submachine">
<constrainedElement xmi:idref="FinalState"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="FinalState-cannot_reference_submachine-_specification">
<body>submachine->isEmpty()</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="FinalState-no_entry_behavior" name="no_entry_behavior">
<constrainedElement xmi:idref="FinalState"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="FinalState-no_entry_behavior-_specification">
<body>entry->isEmpty()</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="FinalState-no_state_behavior" name="no_state_behavior">
<constrainedElement xmi:idref="FinalState"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="FinalState-no_state_behavior-_specification">
<body>doActivity->isEmpty()</body>
<language>OCL</language>
</specification>
</ownedRule>
<generalization xmi:type="uml:Generalization" xmi:id="FinalState-_generalization.0" general="State"/>
<ownedOperation xmi:type="uml:Operation" xmi:id="FinalState-isConsistentWith" name="isConsistentWith" visibility="public" bodyCondition="FinalState-isConsistentWith-spec">
<precondition xmi:idref="FinalState-isConsistentWith-pre"/>
<redefinedOperation xmi:idref="RedefinableElement-isConsistentWith"/>

<ownedRule xmi:type="uml:Constraint" xmi:id="FinalState-isConsistentWith-pre" name="pre">
<constrainedElement xmi:idref="FinalState-isConsistentWith"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="FinalState-isConsistentWith-pre-_specification">
<body>redefiningElement.isRedefinitionContextValid(self)</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedRule xmi:type="uml:Constraint" xmi:id="FinalState-isConsistentWith-spec" name="spec">
<constrainedElement xmi:idref="FinalState-isConsistentWith"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="FinalState-isConsistentWith-spec-_specification">
<body>result = redefiningElement.oclIsKindOf(FinalState)</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedParameter xmi:type="uml:Parameter" xmi:id="FinalState-isConsistentWith-redefiningElement" name="redefiningElement" visibility="public" type="RedefinableElement"/>
