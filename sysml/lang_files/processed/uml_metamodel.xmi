<body>regionAsInput->notEmpty() xor regionAsOutput->notEmpty()</body>
<language>OCL</language>
</specification>
</ownedRule>
<generalization xmi:type="uml:Generalization" xmi:id="ExpansionNode-_generalization.0" general="ObjectNode"/>
<ownedAttribute xmi:type="uml:Property" xmi:id="ExpansionNode-regionAsInput" name="regionAsInput" type="ExpansionRegion" association="A_inputElement_regionAsInput">

<lowerValue xmi:type="uml:LiteralInteger" xmi:id="ExpansionNode-regionAsInput-_lowerValue"/>
</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="ExpansionNode-regionAsOutput" name="regionAsOutput" type="ExpansionRegion" association="A_outputElement_regionAsOutput">

<lowerValue xmi:type="uml:LiteralInteger" xmi:id="ExpansionNode-regionAsOutput-_lowerValue"/>
</ownedAttribute>
</packagedElement>
