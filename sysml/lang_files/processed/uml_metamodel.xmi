<ownedRule xmi:type="uml:Constraint" xmi:id="Element-allOwnedElements-spec" name="spec">
<constrainedElement xmi:idref="Element-allOwnedElements"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="Element-allOwnedElements-spec-_specification">
<body>result = (ownedElement->union(ownedElement->collect(e | e.allOwnedElements()))->asSet())</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedParameter xmi:type="uml:Parameter" xmi:id="Element-allOwnedElements-result" name="result" direction="return" type="Element">
