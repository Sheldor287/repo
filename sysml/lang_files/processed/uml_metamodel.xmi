<upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="LoopNode-setupPart-_upperValue" value="*"/>
</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" xmi:id="LoopNode-test" name="test" type="ExecutableNode" association="A_test_loopNode">

