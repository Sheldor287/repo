<ownedOperation xmi:type="uml:Operation" xmi:id="StartObjectBehaviorAction-behavior" name="behavior" isQuery="true" bodyCondition="StartObjectBehaviorAction-behavior-spec">

<ownedRule xmi:type="uml:Constraint" xmi:id="StartObjectBehaviorAction-behavior-spec" name="spec">
<constrainedElement xmi:idref="StartObjectBehaviorAction-behavior"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="StartObjectBehaviorAction-behavior-spec-_specification">
<body>result = (if object.type.oclIsKindOf(Behavior) then object.type.oclAsType(Behavior) else if object.type.oclIsKindOf(BehavioredClassifier) then object.type.oclAsType(BehavioredClassifier).classifierBehavior else null endif endif)</body>
<language>OCL</language>
</specification>
</ownedRule>
