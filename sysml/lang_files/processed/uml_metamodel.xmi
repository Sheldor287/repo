<constrainedElement xmi:idref="Classifier-inheritedMember"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="Classifier-inheritedMember.1-spec-_specification">
<body>result = (inherit(parents()->collect(inheritableMembers(self))->asSet()))</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedParameter xmi:type="uml:Parameter" xmi:id="Classifier-inheritedMember.1-result" name="result" direction="return" type="NamedElement">
