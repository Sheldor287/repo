<constrainedElement xmi:idref="WriteVariableAction"/>

<specification xmi:type="uml:OpaqueExpression" xmi:id="WriteVariableAction-value_type-_specification">
<body>value &lt;&gt; null implies value.type.conformsTo(variable.type)</body>
<language>OCL</language>
</specification>
</ownedRule>
