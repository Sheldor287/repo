<specification xmi:type="uml:OpaqueExpression" xmi:id="CallAction-result_pins-_specification">
<body>let parameter: OrderedSet(Parameter) = self.outputParameters() in result->size() = parameter->size() and Sequence{1..result->size()}->forAll(i | parameter->at(i).type.conformsTo(result->at(i).type) and parameter->at(i).isOrdered = result->at(i).isOrdered and parameter->at(i).compatibleWith(result->at(i)))</body>
<language>OCL</language>
</specification>
