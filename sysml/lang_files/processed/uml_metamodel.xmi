<constrainedElement xmi:idref="LoopNode-allActions"/>
<specification xmi:type="uml:OpaqueExpression" xmi:id="LoopNode-allActions-spec-_specification">
<body>result = (self->asSet())</body>
<language>OCL</language>
</specification>
