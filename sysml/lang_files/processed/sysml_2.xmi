<specification xmi:id="Systems-Requirements-RequirementConstraintMembership-validateRequirementConstraintMembershipIsComposite-specification0" xmi:type="uml:OpaqueExpression" body="ownedConstraint.isComposite" language="OCL2.0" name=""/>
