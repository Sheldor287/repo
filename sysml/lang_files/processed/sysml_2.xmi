<specification xmi:id="Systems-Constraints-AssertConstraintUsage-deriveAssertConstraintUsageAssertedConstraint-specification0" xmi:type="uml:OpaqueExpression" body="assertedConstraint = if referencedFeatureTarget() = null then self else if referencedFeatureTarget().oclIsKindOf(ConstraintUsage) then referencedFeatureTarget().oclAsType(ConstraintUsage) else null endif endif" language="OCL2.0" name=""> </specification>
