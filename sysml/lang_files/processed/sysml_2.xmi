<ownedRule xmi:id="Systems-Requirements-SatisfyRequirementUsage-checkSatisfyRequirementUsageBindingConnector" xmi:type="uml:Constraint" name="checkSatisfyRequirementUsageBindingConnector">
<constrainedElement xmi:idref="Systems-Requirements-SatisfyRequirementUsage"/>

<specification xmi:id="Systems-Requirements-SatisfyRequirementUsage-checkSatisfyRequirementUsageBindingConnector-specification0" xmi:type="uml:OpaqueExpression" body="ownedMember-&gt;selectByKind(BindingConnector)-&gt; select(b | b.relatedElement-&gt;includes(subjectParameter) and b.relatedElement-&gt;exists(r | r &lt;&gt; subjectParameter))-&gt; size() = 1" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-Requirements-SatisfyRequirementUsage-checkSatisfyRequirementUsageSpecialization" xmi:type="uml:Constraint" name="checkSatisfyRequirementUsageSpecialization">
<constrainedElement xmi:idref="Systems-Requirements-SatisfyRequirementUsage"/>

<specification xmi:id="Systems-Requirements-SatisfyRequirementUsage-checkSatisfyRequirementUsageSpecialization-specification0" xmi:type="uml:OpaqueExpression" body="if isNegated then specializesFromLibrary('Requirements::notSatisfiedRequirementChecks') else specializesFromLibrary('Requirements::satisfiedRequirementChecks') endif" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-Requirements-SatisfyRequirementUsage-deriveSatisfyRequirementUsageSatisfyingFeature" xmi:type="uml:Constraint" name="deriveSatisfyRequirementUsageSatisfyingFeature">
<constrainedElement xmi:idref="Systems-Requirements-SatisfyRequirementUsage"/>

<specification xmi:id="Systems-Requirements-SatisfyRequirementUsage-deriveSatisfyRequirementUsageSatisfyingFeature-specification0" xmi:type="uml:OpaqueExpression" body="satisfyingFeature = let bindings: BindingConnector = ownedMember-&gt; selectByKind(BindingConnector)-&gt; select(b | b.relatedElement-&gt;includes(subjectParameter)) in if bindings-&gt;isEmpty() or bindings-&gt;first().relatedElement-&gt;exits(r | r &lt;&gt; subjectParameter) then null else bindings-&gt;first().relatedElement-&gt;any(r | r &lt;&gt; subjectParameter) endif" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-Requirements-SatisfyRequirementUsage-validateSatisfyRequirementUsageReference" xmi:type="uml:Constraint" name="validateSatisfyRequirementUsageReference">
<constrainedElement xmi:idref="Systems-Requirements-SatisfyRequirementUsage"/>

<specification xmi:id="Systems-Requirements-SatisfyRequirementUsage-validateSatisfyRequirementUsageReference-specification0" xmi:type="uml:OpaqueExpression" body="referencedFeatureTarget() &lt;&gt; null implies referencedFeatureTarget().oclIsKindOf(RequirementUsage)" language="OCL2.0" name=""/>
</ownedRule>
</packagedElement>
</packagedElement>
