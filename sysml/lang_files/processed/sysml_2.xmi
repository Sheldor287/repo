<specification xmi:id="Systems-States-TransitionUsage-sourceFeature_-unnamed1-specification0" xmi:type="uml:OpaqueExpression" body="let features : Sequence(Feature) = ownedMembership-&gt; reject(oclIsKindOf(FeatureMembership)).memberElement-&gt; selectByKind(Feature)-&gt; select(featureTarget.oclIsKindOf(ActionUsage)) in if features-&gt;isEmpty() then null else features-&gt;first() endif" language="OCL2.0" name=""> </specification>
</bodyCondition>

