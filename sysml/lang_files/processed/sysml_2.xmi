<specification xmi:id="Systems-States-StateUsage-isSubstateUsage_Boolean-unnamed1-specification0" xmi:type="uml:OpaqueExpression" body="isComposite and owningType &lt;&gt; null and (owningType.oclIsKindOf(StateDefinition) and owningType.oclAsType(StateDefinition).isParallel = isParallel or owningType.oclIsKindOf(StateUsage) and owningType.oclAsType(StateUsage).isParallel = isParallel) and not owningFeatureMembership.oclIsKindOf(StateSubactionMembership)" language="OCL2.0" name=""> </specification>
</bodyCondition>

