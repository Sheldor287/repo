<ownedRule xmi:id="Systems-Requirements-RequirementDefinition-deriveRequirementDefinitionSubjectParameter" xmi:type="uml:Constraint" name="deriveRequirementDefinitionSubjectParameter">
<constrainedElement xmi:idref="Systems-Requirements-RequirementDefinition"/>

<specification xmi:id="Systems-Requirements-RequirementDefinition-deriveRequirementDefinitionSubjectParameter-specification0" xmi:type="uml:OpaqueExpression" body="subjectParameter = let subjects : OrderedSet(SubjectMembership) = featureMembership-&gt;selectByKind(SubjectMembership) in if subjects-&gt;isEmpty() then null else subjects-&gt;first().ownedSubjectParameter endif" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-Requirements-RequirementDefinition-validateRequirementDefinitionOnlyOneSubject" xmi:type="uml:Constraint" name="validateRequirementDefinitionOnlyOneSubject">
<constrainedElement xmi:idref="Systems-Requirements-RequirementDefinition"/>

<specification xmi:id="Systems-Requirements-RequirementDefinition-validateRequirementDefinitionOnlyOneSubject-specification0" xmi:type="uml:OpaqueExpression" body="featureMembership-&gt; selectByKind(SubjectMembership)-&gt; size() &lt;= 1" language="OCL2.0" name=""/>
</ownedRule>
<ownedRule xmi:id="Systems-Requirements-RequirementDefinition-validateRequirementDefinitionSubjectParameterPosition" xmi:type="uml:Constraint" name="validateRequirementDefinitionSubjectParameterPosition">
<constrainedElement xmi:idref="Systems-Requirements-RequirementDefinition"/>

<specification xmi:id="Systems-Requirements-RequirementDefinition-validateRequirementDefinitionSubjectParameterPosition-specification0" xmi:type="uml:OpaqueExpression" body="input-&gt;notEmpty() and input-&gt;first() = subjectParameter" language="OCL2.0" name=""/>
</ownedRule>
<ownedRule xmi:id="Systems-Requirements-RequirementDefinition-deriveRequirementDefinitionText" xmi:type="uml:Constraint" name="deriveRequirementDefinitionText">
<constrainedElement xmi:idref="Systems-Requirements-RequirementDefinition"/>

<specification xmi:id="Systems-Requirements-RequirementDefinition-deriveRequirementDefinitionText-specification0" xmi:type="uml:OpaqueExpression" body="text = documentation.body" language="OCL2.0" name=""/>
</ownedRule>
<ownedRule xmi:id="Systems-Requirements-RequirementDefinition-deriveRequirementDefinitionActorParameter" xmi:type="uml:Constraint" name="deriveRequirementDefinitionActorParameter">
