<specification xmi:id="Systems-Actions-ActionUsage-inputParameter_Integer-unnamed1-specification0" xmi:type="uml:OpaqueExpression" body="if inputParameters()-&gt;size() &lt; i then null else inputParameters()-&gt;at(i) endif" language="OCL2.0" name=""/>
