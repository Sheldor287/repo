</ownedRule>
<ownedRule xmi:id="Systems-Actions-TriggerInvocationExpression-validateTriggerInvocationExpressionWhenArgument" xmi:type="uml:Constraint" name="validateTriggerInvocationExpressionWhenArgument">
<constrainedElement xmi:idref="Systems-Actions-TriggerInvocationExpression"/>

<specification xmi:id="Systems-Actions-TriggerInvocationExpression-validateTriggerInvocationExpressionWhenArgument-specification0" xmi:type="uml:OpaqueExpression" body="kind = TriggerKind::when implies argument-&gt;notEmpty() and argument-&gt;at(1).oclIsKindOf(FeatureReferenceExpression) and let referent : Feature = argument-&gt;at(1).oclAsType(FeatureReferenceExpression).referent in referent.oclIsKindOf(Expression) and referent.oclAsType(Expression).result.specializesFromLibrary('ScalarValues::Boolean')" language="OCL2.0" name=""> </specification>
</ownedRule>
</packagedElement>
