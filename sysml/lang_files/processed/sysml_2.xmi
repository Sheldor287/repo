<ownedOperation xmi:id="Systems-Actions-ControlNode-multiplicityHasBounds_Multiplicity_Integer_UnlimitedNatural" xmi:type="uml:Operation" name="multiplicityHasBounds">
<bodyCondition xmi:id="Systems-Actions-ControlNode-multiplicityHasBounds_Multiplicity_Integer_UnlimitedNatural-unnamed1" xmi:type="uml:Constraint" name="unnamed1">
<specification xmi:id="Systems-Actions-ControlNode-multiplicityHasBounds_Multiplicity_Integer_UnlimitedNatural-unnamed1-specification0" xmi:type="uml:OpaqueExpression" body="mult &lt;&gt; null and if mult.oclIsKindOf(MultiplicityRange) then mult.oclAsType(MultiplicityRange).hasBounds(lower, upper) else mult.allSuperTypes()-&gt;exists( oclisKindOf(MultiplicityRange) and oclAsType(MultiplicityRange).hasBounds(lower, upper) endif" language="OCL2.0" name=""> </specification>
</bodyCondition>

<ownedParameter xmi:id="Systems-Actions-ControlNode-multiplicityHasBounds_Multiplicity_Integer_UnlimitedNatural-mult" xmi:type="uml:Parameter" name="mult">
<type href="https://www.omg.org/spec/KerML/20250201/KerML.xmi#Core-Types-Multiplicity"/>
</ownedParameter>
<ownedParameter xmi:id="Systems-Actions-ControlNode-multiplicityHasBounds_Multiplicity_Integer_UnlimitedNatural-lower" xmi:type="uml:Parameter" name="lower">
<type href="https://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#Integer"/>
</ownedParameter>
<ownedParameter xmi:id="Systems-Actions-ControlNode-multiplicityHasBounds_Multiplicity_Integer_UnlimitedNatural-upper" xmi:type="uml:Parameter" name="upper">
<type href="https://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#UnlimitedNatural"/>
</ownedParameter>
<ownedParameter xmi:id="Systems-Actions-ControlNode-multiplicityHasBounds_Multiplicity_Integer_UnlimitedNatural-" xmi:type="uml:Parameter" name="">
<type href="https://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#Boolean"/>
</ownedParameter>
<ownedRule xmi:idref="Systems-Actions-ControlNode-multiplicityHasBounds_Multiplicity_Integer_UnlimitedNatural-unnamed1"/>
</ownedOperation>
