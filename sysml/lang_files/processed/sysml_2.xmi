<specification xmi:id="Systems-Occurrences-EventOccurrenceUsage-validateEventOccurrenceUsageIsReference-specification0" xmi:type="uml:OpaqueExpression" body="isReference" language="OCL2.0" name=""/>
</ownedRule>
</packagedElement>
