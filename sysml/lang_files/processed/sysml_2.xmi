<ownedRule xmi:id="Systems-Occurrences-EventOccurrenceUsage-validateEventOccurrenceUsageReference" xmi:type="uml:Constraint" name="validateEventOccurrenceUsageReference">
<constrainedElement xmi:idref="Systems-Occurrences-EventOccurrenceUsage"/>

<specification xmi:id="Systems-Occurrences-EventOccurrenceUsage-validateEventOccurrenceUsageReference-specification0" xmi:type="uml:OpaqueExpression" body="referencedFeatureTarget() &lt;&gt; null implies referencedFeatureTarget().oclIsKindOf(OccurrenceUsage)" language="OCL2.0" name=""/>
</ownedRule>
<ownedRule xmi:id="Systems-Occurrences-EventOccurrenceUsage-deriveEventOccurrenceUsageEventOccurrence" xmi:type="uml:Constraint" name="deriveEventOccurrenceUsageEventOccurrence">
<constrainedElement xmi:idref="Systems-Occurrences-EventOccurrenceUsage"/>

<specification xmi:id="Systems-Occurrences-EventOccurrenceUsage-deriveEventOccurrenceUsageEventOccurrence-specification0" xmi:type="uml:OpaqueExpression" body="eventOccurrence = if referencedFeatureTarget() = null then self else if referencedFeatureTarget().oclIsKindOf(OccurrenceUsage) then referencedFeatureTarget().oclAsType(OccurrenceUsage) else null endif endif" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-Occurrences-EventOccurrenceUsage-checkEventOccurrenceUsageSpecialization" xmi:type="uml:Constraint" name="checkEventOccurrenceUsageSpecialization">
<constrainedElement xmi:idref="Systems-Occurrences-EventOccurrenceUsage"/>

<specification xmi:id="Systems-Occurrences-EventOccurrenceUsage-checkEventOccurrenceUsageSpecialization-specification0" xmi:type="uml:OpaqueExpression" body="owningType &lt;&gt; null and (owningType.oclIsKindOf(OccurrenceDefinition) or owningType.oclIsKindOf(OccurrenceUsage)) implies specializesFromLibrary('Occurrences::Occurrence::timeEnclosedOccurrences')" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-Occurrences-EventOccurrenceUsage-validateEventOccurrenceUsageIsReference" xmi:type="uml:Constraint" name="validateEventOccurrenceUsageIsReference">
