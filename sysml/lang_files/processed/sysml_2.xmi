<ownedRule xmi:id="Systems-States-TransitionUsage-deriveTransitionUsageTarget" xmi:type="uml:Constraint" name="deriveTransitionUsageTarget">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-deriveTransitionUsageTarget-specification0" xmi:type="uml:OpaqueExpression" body="target = if succession.targetFeature-&gt;isEmpty() then null else let targetFeature : Feature = succession.targetFeature-&gt;first().featureTarget in if not targetFeature.oclIsKindOf(ActionUsage) then null else targetFeature.oclAsType(ActionUsage) endif endif " language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-checkTransitionUsageSpecialization" xmi:type="uml:Constraint" name="checkTransitionUsageSpecialization">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-checkTransitionUsageSpecialization-specification0" xmi:type="uml:OpaqueExpression" body="specializesFromLibrary('Actions::transitionActions')" language="OCL2.0" name=""/>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-validateTransitionUsageSuccession" xmi:type="uml:Constraint" name="validateTransitionUsageSuccession">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-validateTransitionUsageSuccession-specification0" xmi:type="uml:OpaqueExpression" body="let successions : Sequence(Successions) = ownedMember-&gt;selectByKind(Succession) in successions-&gt;notEmpty() and successions-&gt;at(1).targetFeature.featureTarget-&gt; forAll(oclIsKindOf(ActionUsage))" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-deriveTransitionUsageGuardExpression" xmi:type="uml:Constraint" name="deriveTransitionUsageGuardExpression">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-deriveTransitionUsageGuardExpression-specification0" xmi:type="uml:OpaqueExpression" body="guardExpression = ownedFeatureMembership-&gt; selectByKind(TransitionFeatureMembership)-&gt; select(kind = TransitionFeatureKind::trigger).transitionFeature-&gt; selectByKind(Expression)" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-deriveTransitionUsageSource" xmi:type="uml:Constraint" name="deriveTransitionUsageSource">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-deriveTransitionUsageSource-specification0" xmi:type="uml:OpaqueExpression" body="source = let sourceFeature : Feature = sourceFeature() in if sourceFeature = null then null else sourceFeature.featureTarget.oclAsType(ActionUsage)" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-validateTransitionUsageTriggerActions" xmi:type="uml:Constraint" name="validateTransitionUsageTriggerActions">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-validateTransitionUsageTriggerActions-specification0" xmi:type="uml:OpaqueExpression" body="source &lt;&gt; null and not source.oclIsKindOf(StateUsage) implies triggerAction-&gt;isEmpty()" language="OCL2.0" name=""/>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-deriveTransitionUsageEffectAction" xmi:type="uml:Constraint" name="deriveTransitionUsageEffectAction">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-deriveTransitionUsageEffectAction-specification0" xmi:type="uml:OpaqueExpression" body="triggerAction = ownedFeatureMembership-&gt; selectByKind(TransitionFeatureMembership)-&gt; select(kind = TransitionFeatureKind::trigger).transitionFeatures-&gt; selectByKind(AcceptActionUsage)" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-checkTransitionUsageSuccessionBindingConnector" xmi:type="uml:Constraint" name="checkTransitionUsageSuccessionBindingConnector">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-checkTransitionUsageSuccessionBindingConnector-specification0" xmi:type="uml:OpaqueExpression" body="ownedMember-&gt;selectByKind(BindingConnector)-&gt;exists(b | b.relatedFeatures-&gt;includes(succession) and b.relatedFeatures-&gt;includes(resolveGlobal( 'TransitionPerformances::TransitionPerformance::transitionLink')))" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-checkTransitionUsageSourceBindingConnector" xmi:type="uml:Constraint" name="checkTransitionUsageSourceBindingConnector">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-checkTransitionUsageSourceBindingConnector-specification0" xmi:type="uml:OpaqueExpression" body="ownedMember-&gt;selectByKind(BindingConnector)-&gt;exists(b | b.relatedFeatures-&gt;includes(source) and b.relatedFeatures-&gt;includes(inputParameter(1)))" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-checkTransitionUsagePayloadSpecialization" xmi:type="uml:Constraint" name="checkTransitionUsagePayloadSpecialization">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-checkTransitionUsagePayloadSpecialization-specification0" xmi:type="uml:OpaqueExpression" body="triggerAction-&gt;notEmpty() implies let payloadParameter : Feature = inputParameter(2) in payloadParameter &lt;&gt; null and payloadParameter.subsetsChain(triggerAction-&gt;at(1), triggerPayloadParameter())" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-checkTransitionUsageTransitionFeatureSpecialization" xmi:type="uml:Constraint" name="checkTransitionUsageTransitionFeatureSpecialization">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-checkTransitionUsageTransitionFeatureSpecialization-specification0" xmi:type="uml:OpaqueExpression" body="triggerAction-&gt;forAll(specializesFromLibrary('Actions::TransitionAction::accepter') and guardExpression-&gt;forAll(specializesFromLibrary('Actions::TransitionAction::guard') and effectAction-&gt;forAll(specializesFromLibrary('Actions::TransitionAction::effect'))" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-checkTransitionUsageSuccessionSourceSpecialization" xmi:type="uml:Constraint" name="checkTransitionUsageSuccessionSourceSpecialization">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-checkTransitionUsageSuccessionSourceSpecialization-specification0" xmi:type="uml:OpaqueExpression" body="succession.sourceFeature = source" language="OCL2.0" name=""/>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-checkTransitionUsageStateSpecialization" xmi:type="uml:Constraint" name="checkTransitionUsageStateSpecialization">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-checkTransitionUsageStateSpecialization-specification0" xmi:type="uml:OpaqueExpression" body="isComposite and owningType &lt;&gt; null and (owningType.oclIsKindOf(StateDefinition) or owningType.oclIsKindOf(StateUsage)) and source &lt;&gt; null and source.oclIsKindOf(StateUsage) implies specializesFromLibrary('States::StateAction::stateTransitions') " language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-deriveTransitionUsageSuccession" xmi:type="uml:Constraint" name="deriveTransitionUsageSuccession">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-deriveTransitionUsageSuccession-specification0" xmi:type="uml:OpaqueExpression" body="succession = ownedMember-&gt;selectByKind(Succession)-&gt;at(1)" language="OCL2.0" name=""/>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-validateTransitionUsageParameters" xmi:type="uml:Constraint" name="validateTransitionUsageParameters">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-validateTransitionUsageParameters-specification0" xmi:type="uml:OpaqueExpression" body="if triggerAction-&gt;isEmpty() then inputParameters()-&gt;size() &gt;= 1 else inputParameters()-&gt;size() &gt;= 2 endif " language="OCL2.0" name=""/>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-deriveTransitionUsageTriggerAction" xmi:type="uml:Constraint" name="deriveTransitionUsageTriggerAction">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-deriveTransitionUsageTriggerAction-specification0" xmi:type="uml:OpaqueExpression" body="triggerAction = ownedFeatureMembership-&gt; selectByKind(TransitionFeatureMembership)-&gt; select(kind = TransitionFeatureKind::trigger).transitionFeature-&gt; selectByKind(AcceptActionUsage)" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-States-TransitionUsage-checkTransitionUsageActionSpecialization" xmi:type="uml:Constraint" name="checkTransitionUsageActionSpecialization">
<constrainedElement xmi:idref="Systems-States-TransitionUsage"/>

<specification xmi:id="Systems-States-TransitionUsage-checkTransitionUsageActionSpecialization-specification0" xmi:type="uml:OpaqueExpression" body="isComposite and owningType &lt;&gt; null and (owningType.oclIsKindOf(ActionDefinition) or owningType.oclIsKindOf(ActionUsage)) and source &lt;&gt; null and not source.oclIsKindOf(StateUsage) implies specializesFromLibrary('Actions::Action::decisionTransitions')" language="OCL2.0" name=""> </specification>
</ownedRule>
</packagedElement>
