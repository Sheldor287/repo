<specification xmi:id="Systems-Actions-ActionUsage-checkActionUsageSubactionSpecialization-specification0" xmi:type="uml:OpaqueExpression" body="isSubactionUsage() implies specializesFromLibrary('Actions::Action::subactions')" language="OCL2.0" name=""/>
</ownedRule>
