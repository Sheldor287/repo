<specification xmi:id="Systems-DefinitionAndUsage-Usage-referencedFeatureTarget_-unnamed1-specification0" xmi:type="uml:OpaqueExpression" body="if ownedReferenceSubsetting = null then null else ownedReferenceSubsetting.referencedFeature.featureTarget endif" language="OCL2.0" name=""/>
