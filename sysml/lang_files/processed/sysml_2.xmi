<ownedOperation xmi:id="Systems-Actions-ActionUsage-argument_Integer" xmi:type="uml:Operation" name="argument">
<bodyCondition xmi:id="Systems-Actions-ActionUsage-argument_Integer-argumentBody" xmi:type="uml:Constraint" name="argumentBody">
<specification xmi:id="Systems-Actions-ActionUsage-argument_Integer-argumentBody-specification0" xmi:type="uml:OpaqueExpression" body="if inputParameter(i) = null then null else let featureValue : Sequence(FeatureValue) = inputParameter(i). ownedMembership-&gt;select(oclIsKindOf(FeatureValue)) in if featureValue-&gt;isEmpty() then null else featureValue-&gt;at(1).value endif endif" language="OCL2.0" name=""> </specification>
</bodyCondition>

