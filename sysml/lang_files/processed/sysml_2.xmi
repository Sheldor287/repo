<ownedRule xmi:id="Systems-Occurrences-OccurrenceDefinition-checkOccurrenceDefinitionIndividualSpecialization" xmi:type="uml:Constraint" name="checkOccurrenceDefinitionIndividualSpecialization">
<constrainedElement xmi:idref="Systems-Occurrences-OccurrenceDefinition"/>

<specification xmi:id="Systems-Occurrences-OccurrenceDefinition-checkOccurrenceDefinitionIndividualSpecialization-specification0" xmi:type="uml:OpaqueExpression" body="isIndividual implies specializesFromLibrary('Occurrences::Life')" language="OCL2.0" name=""/>
</ownedRule>
<ownedRule xmi:id="Systems-Occurrences-OccurrenceDefinition-checkOccurrenceDefinitionMultiplicitySpecialization" xmi:type="uml:Constraint" name="checkOccurrenceDefinitionMultiplicitySpecialization">
<constrainedElement xmi:idref="Systems-Occurrences-OccurrenceDefinition"/>

<specification xmi:id="Systems-Occurrences-OccurrenceDefinition-checkOccurrenceDefinitionMultiplicitySpecialization-specification0" xmi:type="uml:OpaqueExpression" body="isIndividual implies multiplicity &lt;&gt; null and multiplicity.specializesFromLibrary('Base::zeroOrOne')" language="OCL2.0" name=""> </specification>
</ownedRule>
</packagedElement>
