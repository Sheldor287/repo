<specification xmi:id="Systems-Requirements-RequirementDefinition-deriveRequirementDefinitionActorParameter-specification0" xmi:type="uml:OpaqueExpression" body="actorParameter = featureMembership-&gt; selectByKind(ActorMembership). ownedActorParameter" language="OCL2.0" name=""/>
</ownedRule>
<ownedRule xmi:id="Systems-Requirements-RequirementDefinition-deriveRequirementDefinitionRequiredConstraint" xmi:type="uml:Constraint" name="deriveRequirementDefinitionRequiredConstraint">
<constrainedElement xmi:idref="Systems-Requirements-RequirementDefinition"/>

<specification xmi:id="Systems-Requirements-RequirementDefinition-deriveRequirementDefinitionRequiredConstraint-specification0" xmi:type="uml:OpaqueExpression" body="requiredConstraint = ownedFeatureMembership-&gt; selectByKind(RequirementConstraintMembership)-&gt; select(kind = RequirementConstraintKind::requirement). ownedConstraint" language="OCL2.0" name=""> </specification>
</ownedRule>
<ownedRule xmi:id="Systems-Requirements-RequirementDefinition-deriveRequirementDefinitionAssumedConstraint" xmi:type="uml:Constraint" name="deriveRequirementDefinitionAssumedConstraint">
