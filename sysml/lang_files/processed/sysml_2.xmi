<specification xmi:id="Systems-Requirements-RequirementConstraintMembership-validateRequirementConstraintMembershipOwningType-specification0" xmi:type="uml:OpaqueExpression" body="owningType.oclIsKindOf(RequirementDefinition) or owningType.oclIsKindOf(RequirementUsage)" language="OCL2.0" name=""/>
</ownedRule>
