<upperValue xmi:id="Systems-DefinitionAndUsage-Usage-namingFeature_--upperValue" xmi:type="uml:LiteralUnlimitedNatural" name="" value="1"/>
</ownedParameter>
<ownedRule xmi:idref="Systems-DefinitionAndUsage-Usage-namingFeature_-unnamed1"/>
<redefinedOperation href="https://www.omg.org/spec/KerML/20250201/KerML.xmi#Core-Features-Feature-namingFeature_"/>
