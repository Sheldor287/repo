      <ownedMember xmi:type="cmof:Package" xmi:id="Activities-FundamentalActivities" name="FundamentalActivities">
        <packageMerge xmi:type="cmof:PackageMerge" xmi:id="Activities-FundamentalActivities-_packageMerge.0" receivingPackage="Activities-FundamentalActivities">
          <mergedPackage xmi:type="cmof:Package" href="http://www.omg.org/spec/UML/20090901/Superstructure.cmof#Activities-FundamentalActivities"/>
        </packageMerge>
        <ownedMember xmi:type="cmof:Class" xmi:id="Activities-FundamentalActivities-Activity" name="Activity" superClass="Activities-FundamentalActivities-Behavior">
          <ownedRule xmi:type="cmof:Constraint" xmi:id="Activities-FundamentalActivities-Activity-part_end_name" name="part_end_name" constrainedElement="Activities-FundamentalActivities-Activity" namespace="Activities-FundamentalActivities-Activity">
            <specification xmi:type="cmof:OpaqueExpression" xmi:id="Activities-FundamentalActivities-Activity-part_end_name-_specification">
              <language>OCL</language>
              <body>self.ownedAttribute->forAll(a | (a.type.oclIsKindOf(Activity) and&#xD;                                                 a.aggregation= #composite)&#xD;    implies self.node->exists(n | n.oclIsKindOf(CallBehaviorAction)&#xD;        and n.oclAsType(CallBehaviorAction).isSynchronous= #true and a.type = n.behavior and&#xD;        (( n.name->notEmpty() and n.name=a.name) or ( n.name->empty()&#xD;        and  n.oclAsType(CallBehaviorAction).behavior.name = a.name)))&#xD;</body>
            </specification>
          </ownedRule>
          <ownedAttribute xmi:type="cmof:Property" xmi:id="Activities-FundamentalActivities-Activity-node" name="node" type="Activities-FundamentalActivities-ActivityNode" upper="*" lower="0" association="Activities-FundamentalActivities-A_node_activity"/>
        </ownedMember>
        <ownedMember xmi:type="cmof:Class" xmi:id="Activities-FundamentalActivities-ActivityNode" name="ActivityNode" isAbstract="true">
          <ownedAttribute xmi:type="cmof:Property" xmi:id="Activities-FundamentalActivities-ActivityNode-activity" name="activity" type="Activities-FundamentalActivities-Activity" lower="0" association="Activities-FundamentalActivities-A_node_activity"/>
          <superClass xmi:type="cmof:Class" href="http://www.omg.org/spec/UML/20090901/Superstructure.cmof#Classes-Kernel-NamedElement"/>
        </ownedMember>
        <ownedMember xmi:type="cmof:Class" xmi:id="Activities-FundamentalActivities-Action" name="Action" isAbstract="true" superClass="Activities-FundamentalActivities-ActivityNode"/>
        <ownedMember xmi:type="cmof:Class" xmi:id="Activities-FundamentalActivities-CallBehaviorAction" name="CallBehaviorAction" superClass="Activities-FundamentalActivities-CallAction">
          <ownedAttribute xmi:type="cmof:Property" xmi:id="Activities-FundamentalActivities-CallBehaviorAction-behavior" name="behavior" type="Activities-FundamentalActivities-Behavior" association="Activities-FundamentalActivities-A_behavior_callBehaviorAction"/>
        </ownedMember>
        <ownedMember xmi:type="cmof:Class" xmi:id="Activities-FundamentalActivities-CallAction" name="CallAction" isAbstract="true" superClass="Activities-FundamentalActivities-Action">
          <ownedAttribute xmi:type="cmof:Property" xmi:id="Activities-FundamentalActivities-CallAction-isSynchronous" name="isSynchronous" default="true">
            <ownedComment xmi:type="cmof:Comment" xmi:id="Activities-FundamentalActivities-CallAction-isSynchronous-_ownedComment.0" annotatedElement="Activities-FundamentalActivities-CallAction-isSynchronous">
              <body>If true, the call is synchronous and the caller waits for completion of the invoked behavior.&#xD;
If false, the call is asynchronous and the caller proceeds immediately and does not expect a return values.&#xD;
</body>
            </ownedComment>
            <type xmi:type="cmof:PrimitiveType" href="http://www.omg.org/spec/UML/20090901/Infrastructure.cmof#Core-PrimitiveTypes-Boolean"/>
          </ownedAttribute>
        </ownedMember>
        <ownedMember xmi:type="cmof:Class" xmi:id="Activities-FundamentalActivities-Behavior" name="Behavior" isAbstract="true">
          <superClass xmi:type="cmof:Class" href="http://www.omg.org/spec/UML/20090901/Superstructure.cmof#Classes-Kernel-Class"/>
        </ownedMember>
        <ownedMember xmi:type="cmof:Association" xmi:id="Activities-FundamentalActivities-A_behavior_callBehaviorAction" name="A_behavior_callBehaviorAction" memberEnd="Activities-FundamentalActivities-CallBehaviorAction-behavior Activities-FundamentalActivities-A_behavior_callBehaviorAction-callBehaviorAction">
          <ownedEnd xmi:type="cmof:Property" xmi:id="Activities-FundamentalActivities-A_behavior_callBehaviorAction-callBehaviorAction" name="callBehaviorAction" type="Activities-FundamentalActivities-CallBehaviorAction" upper="*" lower="0" owningAssociation="Activities-FundamentalActivities-A_behavior_callBehaviorAction" association="Activities-FundamentalActivities-A_behavior_callBehaviorAction"/>
        </ownedMember>
        <ownedMember xmi:type="cmof:Association" xmi:id="Activities-FundamentalActivities-A_node_activity" name="A_node_activity" memberEnd="Activities-FundamentalActivities-Activity-node Activities-FundamentalActivities-ActivityNode-activity"/>
