              <definingFeature href="http://www.omg.org/spec/SysML/20161101/SysML.xmi#SysML.package_packagedElement_Libraries.package_packagedElement_UnitAndQuantityKind.class_packagedElement_QuantityKind_ownedAttribute.description"/>
              <value xmi:id="ISO-80000.weight._slot.description.value0" xmi:type="uml:LiteralString" value="ISO 80000-4, 4-9.2"/>
