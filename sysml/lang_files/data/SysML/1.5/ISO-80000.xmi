                  &amp;lt;mml:math xmlns:mml=&amp;quot;http://www.w3.org/1998/Math/MathML&amp;quot;&amp;gt;
&amp;lt;mml:mrow&amp;gt;
&amp;lt;mml:msub&amp;gt;
&amp;lt;mml:mi mathvariant=&amp;quot;bold-italic&amp;quot;&amp;gt;F&amp;lt;/mml:mi&amp;gt;
&amp;lt;mml:mi mathvariant=&amp;quot;normal&amp;quot;&amp;gt;g&amp;lt;/mml:mi&amp;gt;
&amp;lt;/mml:msub&amp;gt;
&amp;lt;mml:mo&amp;gt;,&amp;lt;/mml:mo&amp;gt;
