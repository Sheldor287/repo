				<constrainedElement xmi:idref='_19_0_2_26f0132_1565349260878_452014_55581'/>
				<constrainedElement xmi:idref='_19_0_4_6d8019d_1630514999349_501873_1056'/>
				<specification xmi:type='uml:OpaqueExpression' xmi:id='_2024x_26f0132_1719753695128_918920_27559'>
					<body>&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?&gt;
&lt;unionExpressionSpecification ordered=&quot;true&quot; unique=&quot;true&quot; xmlns=&quot;http://www.nomagic.com/schemas/MagicDraw/StructuredExpression/2013&quot;&gt;
    &lt;taggedValues&gt;
        &lt;entry key=&quot;ROOT_UNION&quot;&gt;
            &lt;value&gt;true&lt;/value&gt;
        &lt;/entry&gt;
        &lt;entry key=&quot;name&quot;&gt;
            &lt;value&gt;Condition&lt;/value&gt;
        &lt;/entry&gt;
    &lt;/taggedValues&gt;
    &lt;value xsi:type=&quot;callExpressionSpecification&quot; includeCustomTypes=&quot;false&quot; includeSubtypes=&quot;true&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot;&gt;
        &lt;taggedValues&gt;
            &lt;entry key=&quot;name&quot;&gt;
                &lt;value&gt;true if domain matches&lt;/value&gt;
            &lt;/entry&gt;
        &lt;/taggedValues&gt;
        &lt;argument xsi:type=&quot;lookupExpressionSpecification&quot; symbol=&quot;THIS&quot;/&gt;
        &lt;argument xsi:type=&quot;elementExpressionSpecification&quot; element=&quot;_2024x_26f0132_1719736322867_114112_27937&quot;&gt;
            &lt;taggedValues&gt;
                &lt;entry key=&quot;name&quot;&gt;
                    &lt;value&gt;Element1&lt;/value&gt;
                &lt;/entry&gt;
            &lt;/taggedValues&gt;
        &lt;/argument&gt;
        &lt;expression xsi:type=&quot;makeInlineExpressionSpecification&quot; language=&quot;Groovy&quot;&gt;
            &lt;parameter name=&quot;element&quot; type=&quot;java.lang.Object&quot; ordered=&quot;false&quot; unique=&quot;false&quot; multiple=&quot;false&quot;/&gt;
            &lt;parameter name=&quot;domain&quot; type=&quot;java.lang.Object&quot; ordered=&quot;false&quot; unique=&quot;false&quot; multiple=&quot;false&quot;/&gt;
            &lt;body&gt;import com.nomagic.uml2.ext.jmi.helpers.StereotypesHelper as sth
import com.nomagic.magicdraw.uml.ClassTypes as umlct
prf = sth.getProfile(project, &quot;SAF_SCM_Profile&quot;)
st_vp = sth.getStereotype(project, &quot;SCM_Viewpoint&quot;,prf)
st_v = sth.getStereotype(project, &quot;SCM_View&quot;,prf)

if (sth.hasStereotypeOrDerived(element,st_vp))
{
 return(sth.getStereotypePropertyValue(element,st_vp,&quot;saf_domain&quot; )[0]==domain)
}
if (sth.hasStereotypeOrDerived(element,st_v) )
{
  vp=sth.getStereotypePropertyValue(element,st_v,&quot;viewPoint&quot; )[0]
  return  sth.getStereotypePropertyValue(vp,st_vp,&quot;saf_domain&quot; )[0]==domain
}
return false        &lt;/body&gt;
        &lt;/expression&gt;
    &lt;/value&gt;
&lt;/unionExpressionSpecification&gt;
</body>
					<language>StructuredExpression</language>
				</specification>
			</ownedRule>
