		<packagedElement xmi:type='uml:OpaqueBehavior' xmi:id='_19_0_4_26f0132_1655466520946_254966_987' name='queryVPofConcern'>
			<body># get all viewpoints and return those that have the arg as concern
                                                                            
import com.nomagic.uml2.ext.jmi.helpers.StereotypesHelper as sth 
import com.nomagic.magicdraw.uml as uml 

fi=uml.Finder.byTypeRecursively()
saf_pro=sth.getProfile(project,&quot;SAF_SCM_Profile&quot;)
safvp_st=sth.getStereotype(project,&quot;SAF_Viewpoint&quot;,saf_pro)
result.set(safvp_st)          
vp_in_scope=fi.find(project,[uml.ClassTypes.getClassType(&quot;Class&quot;)],False)
#result.set(vp_in_scope)       
saf_viewpoints= [vp for vp in vp_in_scope if sth.hasStereotypeOrDerived(vp,safvp_st)]                                                               
#result.set( [svp for svp in saf_viewpoints if arg in svp.concernList ])
result.set([ svp for svp in saf_viewpoints if arg in sth.getStereotypePropertyValue(svp, safvp_st, &quot;concernList&quot;) or  arg in sth.getStereotypePropertyValue(svp, safvp_st, &quot;SAFConcernList&quot;)])       
</body>
			<language>Jython</language>
			<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_26f0132_1655466520948_194489_989' body='the operation queries a scope for diagrams of a certain stereotype&#10;&#10;the operation is intended to be used in a smart package&#10; the smart package must have the SAF_VPQuery stereotype and &#10;   vpDiagStereotypes tag set to the diagram stereotypes to be queried&#10;the owning package of this smart package must have the stereotype SAF_VPSearchScopeproperty  &#10;   and the tag scope set to the model package tree to be queried&#10;'>
				<annotatedElement xmi:idref='_19_0_4_26f0132_1655466520946_254966_987'/>
			</ownedComment>
			<ownedParameter xmi:type='uml:Parameter' xmi:id='_19_0_4_26f0132_1655466520948_330786_988' name='arg' visibility='public'>
				<type href='http://www.omg.org/spec/UML/20131001/UML.xmi#Element'>
					<xmi:Extension extender='MagicDraw UML 2026x'>
						<referenceExtension referentPath='UML Standard Profile::UML2 Metamodel::Element' referentType='Class'/>
					</xmi:Extension>
				</type>
			</ownedParameter>
		</packagedElement>
		<packagedElement xmi:type='uml:Package' xmi:id='_19_0_3_26f0132_1605277634883_256435_37' name='SAF_ConceptValidationSuite'>
			<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_3_26f0132_1605277655903_132653_38' name='ConceptMustHaveRealization'>
				<constrainedElement xmi:idref='_19_0_1_26f0132_1554446849880_209491_45751'/>
				<ownedComment xmi:type='uml:Comment' xmi:id='_2021x_2_8710274_1677505488516_25738_27203' body='Check if concept has a realization relationship.'>
					<annotatedElement xmi:idref='_19_0_3_26f0132_1605277655903_132653_38'/>
				</ownedComment>
				<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_3_26f0132_1605277655903_520360_39'>
					<body>import com.nomagic.uml2.ext.jmi.helpers.StereotypesHelper as sth 

#stereotypes from scm profile
saf_scm_pro=sth.getProfile(project,&quot;SAF_SCM_Profile&quot;)
safrealize_st=sth.getStereotype(project,&quot;SCM_RealizeConcept&quot;,saf_scm_pro)
                     
supdep=THIS.getSupplierDependency()
realizes =  [dep for dep in supdep if sth.hasStereotypeOrDerived(dep ,safrealize_st) ]
result.set(len([s.client for s in realizes])&gt;0 or THIS.isAbstract()==True)
#tbd : check if a constraint SCMRealizationKind is applied</body>
					<language>Jython</language>
				</specification>
			</ownedRule>
			<ownedRule xmi:type='uml:Constraint' xmi:id='_2021x_2_8710274_1674486236209_583070_27391' name='ConceptMustHaveDocu'>
				<constrainedElement xmi:idref='_19_0_1_26f0132_1554446849880_209491_45751'/>
				<ownedComment xmi:type='uml:Comment' xmi:id='_2021x_2_8710274_1677505434354_129077_27202' body='Check Documentation field of concepts'>
					<annotatedElement xmi:idref='_2021x_2_8710274_1674486236209_583070_27391'/>
				</ownedComment>
				<specification xmi:type='uml:OpaqueExpression' xmi:id='_2021x_2_8710274_1674486236211_467693_27394'>
					<body>import com.nomagic.uml2.ext.jmi.helpers.CoreHelper as coh
result.set(coh.getComment(THIS).strip()!=&quot;&quot;)</body>
					<language>Jython</language>
				</specification>
			</ownedRule>
			<ownedRule xmi:type='uml:Constraint' xmi:id='_2021x_2_8710274_1676206963772_230845_25212' name='DePluralisator'>
				<constrainedElement href='http://www.omg.org/spec/UML/20131001/UML.xmi#Element'>
					<xmi:Extension extender='MagicDraw UML 2026x'>
						<referenceExtension referentPath='UML Standard Profile::UML2 Metamodel::Element' referentType='Class'/>
					</xmi:Extension>
				</constrainedElement>
				<ownedComment xmi:type='uml:Comment' xmi:id='_2021x_2_8710274_1677505523928_928186_27204' body='check for pluralisation pattern'>
					<annotatedElement xmi:idref='_2021x_2_8710274_1676206963772_230845_25212'/>
				</ownedComment>
				<specification xmi:type='uml:OpaqueExpression' xmi:id='_2021x_2_8710274_1676206963773_554815_25215'>
					<body>import com.nomagic.uml2.ext.jmi.helpers.CoreHelper as coh
try:   
    docco=coh.getComment(THIS)
    result.set(docco.find(&quot;(s)&quot;) == -1)
except:
    result.set(True)
</body>
					<language>Jython</language>
				</specification>
			</ownedRule>
			<ownedRule xmi:type='uml:Constraint' xmi:id='_2021x_2_8710274_1677496894066_433111_24144' name='ViewpointMustHaveRealization'>
				<constrainedElement xmi:idref='_19_0_2_26f0132_1565349260878_452014_55581'/>
				<ownedComment xmi:type='uml:Comment' xmi:id='_2021x_2_8710274_1677505612383_293918_27207' body='Check if SAF_Viewpoints have a realization relationship.'>
					<annotatedElement xmi:idref='_2021x_2_8710274_1677496894066_433111_24144'/>
				</ownedComment>
				<specification xmi:type='uml:OpaqueExpression' xmi:id='_2021x_2_8710274_1677496894075_819758_24147'>
					<body>import com.nomagic.uml2.ext.jmi.helpers.StereotypesHelper as sth 

#stereotypes from scm profile
saf_scm_pro=sth.getProfile(project,&quot;SAF_SCM_Profile&quot;)
safrealize_st=sth.getStereotype(project,&quot;SCM_RealizeConcept&quot;,saf_scm_pro)
                     
supdep=THIS.getSupplierDependency()
realizes =  [dep for dep in supdep if sth.hasStereotypeOrDerived(dep ,safrealize_st) ]
result.set(len([s.client for s in realizes])&gt;0 or THIS.isAbstract()==True)
#tbd : check if a constraint SCMRealizationKind is applied</body>
					<language>Jython</language>
				</specification>
			</ownedRule>
