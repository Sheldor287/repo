			<ownedRule xmi:type='uml:Constraint' xmi:id='_2024x_8710274_1714298571951_353708_20939' name='ViewpointPackageStructure'>
				<constrainedElement xmi:idref='_2024x_8710274_1714298354769_360256_20899'/>
				<ownedComment xmi:type='uml:Comment' xmi:id='_2024x_8710274_1714298571952_594300_20943' body='Check if packages for viewpoints have required elements'>
					<annotatedElement xmi:idref='_2024x_8710274_1714298571951_353708_20939'/>
				</ownedComment>
				<specification xmi:type='uml:OpaqueExpression' xmi:id='_2024x_8710274_1714298571952_234445_20942'>
					<body>import com.nomagic.uml2.ext.jmi.helpers.StereotypesHelper as sth 

#stereotypes from scm profile
saf_scm_pro=sth.getProfile(project,&quot;SAF_SCM_Profile&quot;)
safrealize_st=sth.getStereotype(project,&quot;SCM_VP_Package&quot;,saf_scm_pro)

patterns={&quot;%s Concept&quot;:&quot;Diagram&quot;,&quot;%s Profile&quot;:&quot;Diagram&quot;,&quot;%s Viewpoint&quot;:&quot;SCM_Viewpoint&quot;,&quot;%s View&quot;:&quot;SCM_View&quot;}
req_kinds={}
for p in patterns:
  req_kinds[ p % THIS.name ]= patterns[p]
 
element_map={}
for e in THIS.member:
  element_map[e.name]=e.getHumanType()
    
res=True
for req_k in req_kinds:
  if not req_k in element_map: # an required element ist not part of member list. 
    res=False
  elif req_kinds[req_k] != element_map[req_k]: # element found but wrong type
    res=False
      

result.set(res)
#tbd : check if a constraint SCMRealizationKind is applied</body>
					<language>Jython</language>
				</specification>
			</ownedRule>
