			<packagedElement xmi:type='uml:Stereotype' xmi:id='_2021x_2_8710274_1674486070195_664660_27223' name='SCM_VPStakeholder'>
				<ownedComment xmi:type='uml:Comment' xmi:id='_2021x_2_8710274_1674571105010_336822_31233' body='A stakeholder having concerns framed by viewpoints. These stakeholders are only used in the SAF specification model to capture concerns of viewpoints. They may not be used in a system model.&#10;Used for specifying SAF.'>
