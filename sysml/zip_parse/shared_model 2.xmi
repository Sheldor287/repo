            &lt;body&gt;import com.nomagic.uml2.ext.jmi.helpers.StereotypesHelper as sth
import com.nomagic.magicdraw.uml.ClassTypes as umlct
prf = sth.getProfile(project, &quot;SAF_SCM_Profile&quot;)
st_vp = sth.getStereotype(project, &quot;SCM_Viewpoint&quot;,prf)
st_v = sth.getStereotype(project, &quot;SCM_View&quot;,prf)

if (sth.hasStereotypeOrDerived(element,st_vp))
{
 return(sth.getStereotypePropertyValue(element,st_vp,&quot;saf_domain&quot; )[0]==domain)
}
if (sth.hasStereotypeOrDerived(element,st_v) )
{
  vp=sth.getStereotypePropertyValue(element,st_v,&quot;viewPoint&quot; )[0]
  return  sth.getStereotypePropertyValue(vp,st_vp,&quot;saf_domain&quot; )[0]==domain
}
return false        &lt;/body&gt;
        &lt;/expression&gt;
    &lt;/value&gt;
