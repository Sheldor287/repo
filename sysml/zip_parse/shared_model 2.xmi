	<DSL_Customization:derivedPropertySpecification xmi:id='_2021x_2_8710274_1675260759069_634631_23806_' base_Property='_2021x_2_8710274_1675260759069_634631_23806'>
		<expression>&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?&gt;
&lt;callExpressionSpecification includeCustomTypes=&quot;false&quot; includeSubtypes=&quot;true&quot; xmlns=&quot;http://www.nomagic.com/schemas/MagicDraw/StructuredExpression/2013&quot;&gt;
    &lt;taggedValues&gt;
        &lt;entry key=&quot;name&quot;&gt;
            &lt;value&gt;Script1&lt;/value&gt;
        &lt;/entry&gt;
    &lt;/taggedValues&gt;
    &lt;argument xsi:type=&quot;lookupExpressionSpecification&quot; symbol=&quot;THIS&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot;/&gt;
    &lt;expression xsi:type=&quot;makeInlineExpressionSpecification&quot; language=&quot;Jython&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot;&gt;
        &lt;parameter name=&quot;arg1&quot; type=&quot;java.lang.Object&quot; ordered=&quot;false&quot; unique=&quot;false&quot; multiple=&quot;false&quot;/&gt;
        &lt;body&gt;import com.nomagic.uml2.ext.jmi.helpers.StereotypesHelper as sth
saf_scm_pro=sth.getProfile(project,&quot;SAF_SCM_Profile&quot;)
safvp_st=sth.getStereotype(project,&quot;SCM_Viewpoint&quot;,saf_scm_pro)
safas_st=sth.getStereotype(project,&quot;SCM_AspectColumn&quot;,saf_scm_pro)
safdo_st=sth.getStereotype(project,&quot;SCM_DomainLayer&quot;,saf_scm_pro)

idstring=&quot;domain, aspect or id unset&quot;
try:
    aspect=sth.getStereotypePropertyValue(arg1,safvp_st,&quot;saf_aspect&quot;)
    domain=sth.getStereotypePropertyValue(arg1,safvp_st,&quot;saf_domain&quot;)
    aspectid=sth.getStereotypePropertyValue(aspect[0],safas_st,&quot;ID&quot;)
    domainid=sth.getStereotypePropertyValue(domain[0],safdo_st,&quot;ID&quot;)
    vpid=sth.getStereotypePropertyValue(arg1,safvp_st,&quot;id&quot;)
    idstring= &quot;%s%s_%s&quot; % (domainid[0],aspectid[0],vpid[0])
except:
    pass
result.set(idstring)
&lt;/body&gt;
    &lt;/expression&gt;
&lt;/callExpressionSpecification&gt;
</expression>
	</DSL_Customization:derivedPropertySpecification>
