        &lt;expression xsi:type=&quot;makeInlineExpressionSpecification&quot; language=&quot;Groovy&quot;&gt;
            &lt;parameter name=&quot;element&quot; type=&quot;java.lang.Object&quot; ordered=&quot;false&quot; unique=&quot;false&quot; multiple=&quot;false&quot;/&gt;
